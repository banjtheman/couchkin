# GPT-Live speech and its tool backend use your own OpenAI API account.
# Copy this file to .env and set the key locally. Never commit .env.
OPENAI_API_KEY=
# Codex + Mac voice fallback needs no API key.
# Install Codex CLI separately, then run: codex login
# Optional override for installations where codex is not in PATH:
# COUCHKIN_CODEX_BIN=/absolute/path/to/codex
