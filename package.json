{
  "name": "couchkin",
  "version": "0.1.0",
  "private": true,
  "description": "A little friend on the couch: a local Codex-powered companion for Twitch and OBS.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "dist:mac": "npm run build && electron-builder --mac --dir",
    "format": "prettier --write src tests electron.vite.config.ts"
  },
  "build": {
    "appId": "dev.couchkin.desktop",
    "productName": "Couchkin",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Couchkin listens when you enable your microphone to chat about your game."
      },
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": false
    },
    "asar": true
  },
  "dependencies": {
    "obs-websocket-js": "^5.0.8",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.61.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "Couchkin contributors"
}
